{
  "name": "paperdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node scripts/start-local.mjs --mode preview --open",
    "ai": "node server/index.mjs",
    "dev": "node scripts/start-local.mjs --mode dev",
    "dev:web": "npm run validate:content && vite",
    "validate:content": "node scripts/validate-content.mjs && node scripts/build-content-index.mjs",
    "reading:materials": "node scripts/reading-materials.mjs",
    "import:content": "node scripts/import-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate:content && npm run typecheck && vite build",
    "preview": "node scripts/start-local.mjs --mode preview",
    "preview:web": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "dompurify": "3.4.17",
    "jose": "6.2.13",
    "katex": "0.19.0",
    "mermaid": "12.2.0",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "undici": "7.30.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "$katex"
    }
  }
}
