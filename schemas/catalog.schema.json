{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaperDesk catalog v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "archivedGuideIds": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
      }
    },
    "currentRevisions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1000,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "guideId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "metadataFile": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[A-Za-z0-9_./-]+$",
            "maxLength": 200
          },
          "recommendation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "relation": {
                "const": "editorial-reading-order"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "rank",
              "relation",
              "reason"
            ]
          }
        },
        "required": [
          "guideId",
          "revision",
          "metadataFile",
          "recommendation"
        ]
      },
      "maxItems": 10000,
      "minItems": 1
    },
    "exploration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentRevision",
        "revisions"
      ],
      "properties": {
        "currentRevision": {
          "type": "integer",
          "minimum": 1
        },
        "revisions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 10000,
          "propertyNames": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[A-Za-z0-9_./-]+$",
            "maxLength": 200
          }
        }
      }
    },
    "readingAssignments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batches",
        "activeBatchIds"
      ],
      "properties": {
        "batches": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "collectionId",
              "titleAliases",
              "guides"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
              },
              "collectionId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
              },
              "titleAliases": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "guides": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "guideId",
                    "revision"
                  ],
                  "properties": {
                    "guideId": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "activeBatchIds": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "currentRevisions",
    "entries",
    "exploration"
  ]
}
