# Reinstallable dependencies, builds and local tooling
/node_modules/
/dist/
/.cache/

# Legacy browser evidence path; new checks write .cache/screenshots/
# Curated versioned images remain in docs/images/
/docs/evidence/*.png

# Local configuration and private records
*.local
*.log
.env
.env.*
!.env.example
/private/
/server/config.local.json
paperdesk-ai-backup-*.json
/personal-data/
/backups/
paperdesk-backup-*.json

# Authoring packages and recovery receipts never form part of the app source
/incoming/
/.content-update/
/.source-review/

# Older tooling locations (safe for existing local checkouts)
/.npm-cache/
/.playwright/
/.tmp-tests/
/test-results/
/playwright-report/
/tests/.tmp/
.DS_Store
Thumbs.db
